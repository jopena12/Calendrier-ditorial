# Supabase — projet dédié au calendrier éditorial
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Anthropic — clé serveur uniquement, jamais préfixée NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...

# Modèles (optionnel). Par défaut : Sonnet 5 pour les posts (le volume),
# Opus 5 pour l'analyse de marque (une fois par marque, qualité critique).
# Pour tout passer en Opus : ANTHROPIC_MODEL_POSTS=claude-opus-5
# ANTHROPIC_MODEL_POSTS=claude-sonnet-5
# ANTHROPIC_MODEL_ANALYSIS=claude-opus-5
